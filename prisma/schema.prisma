generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  directUrl = env("POSTGRES_URL_NON_POOLING")
  url       = env("POSTGRES_PRISMA_URL")
}

model Project {
  id           String       @id @default(uuid())
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  published    Boolean      @default(false)
  hilight      Boolean      @default(false)
  name         String       @unique
  description  String       @default("")
  projdesc     String       @default("")
  projgoal     String       @default("")
  projpers     String       @default("")
  image        String?
  url          String?
  source       String?
  role         String
  date         DateTime     @default(now())
  tags         Tag[]        @relation("ProjectToTag")
  technologies Technology[] @relation("ProjectToTechnology")
}

model Technology {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  experties Int       @default(0)
  project   Project[] @relation("ProjectToTechnology")
}

model Tag {
  id      Int       @id @default(autoincrement())
  name    String    @unique
  project Project[] @relation("ProjectToTag")
}

model Blog {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  published Boolean   @default(false)
  slug      String    @unique
  title     String
  date      DateTime  @default(now())
  excerpt   String    @default("")
  banner    String?
  content   String[]
  tags      BlogTag[]
}

model BlogTag {
  id    Int    @id @default(autoincrement())
  name  String @unique
  blogs Blog[]
}

enum ExperienceType {
  WORK
  EDUCATION
  ORGANISATION
}

model Experience {
  id          String         @id @default(uuid())
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  type        ExperienceType
  institution String
  role        String
  from        String
  to          String
  description String[]
  logo        String?
  order       Int            @default(0)
}
